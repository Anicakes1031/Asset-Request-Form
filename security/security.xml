<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_it_department" model="res.groups">
        <field name="name">IT Department</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    
    <record id="group_ceo" model="res.groups">
        <field name="name">CEO</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    
    <record id="group_treasury" model="res.groups">
        <field name="name">Treasury Department</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- Employee: Own requests only -->
    <record id="asset_form_employee_rule" model="ir.rule">
        <field name="name">Employee: Own Requests Only</field>
        <field name="model_id" ref="model_asset_form"/>
        <field name="global">0</field>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- IT Department: All requests -->
    <record id="asset_form_it_rule" model="ir.rule">
        <field name="name">IT Department: All Requests</field>
        <field name="model_id" ref="model_asset_form"/>
        <field name="global">1</field>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_it_department'))]"/>
    </record>

    <!-- CEO: All requests -->
    <record id="asset_form_ceo_rule" model="ir.rule">
        <field name="name">CEO: All Requests</field>
        <field name="model_id" ref="model_asset_form"/>
        <field name="global">1</field>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ceo'))]"/>
    </record>

    <!-- Treasury: All requests -->
    <record id="asset_form_treasury_rule" model="ir.rule">
        <field name="name">Treasury: All Requests</field>
        <field name="model_id" ref="model_asset_form"/>
        <field name="global">1</field>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_treasury'))]"/>
    </record>

    <!-- Admin: All requests -->
    <record id="asset_form_admin_rule" model="ir.rule">
        <field name="name">Admin: All Requests</field>
        <field name="model_id" ref="model_asset_form"/>
        <field name="global">1</field>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- Block create for all users -->
    <record id="asset_form_create_block_rule" model="ir.rule">
        <field name="name">Block Create Access</field>
        <field name="model_id" ref="model_asset_form"/>
        <field name="global">1</field>
        <field name="perm_create">0</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- IT Department can create -->
    <record id="asset_form_create_it_rule" model="ir.rule">
        <field name="name">IT Department can create</field>
        <field name="model_id" ref="model_asset_form"/>
        <field name="global">1</field>
        <field name="perm_create">1</field>
        <field name="groups" eval="[(4, ref('group_it_department'))]"/>
    </record>

    <!-- Admin can create -->
    <record id="asset_form_create_admin_rule" model="ir.rule">
        <field name="name">Admin can create</field>
        <field name="model_id" ref="model_asset_form"/>
        <field name="global">1</field>
        <field name="perm_create">1</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>